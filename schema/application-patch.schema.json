{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "student": {
      "type": "object",
      "properties": {
        "first_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "last_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "preferred_name": {
          "type": "string",
          "maxLength": 60
        },
        "date_of_birth": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "current_school": {
          "type": "string",
          "maxLength": 160
        },
        "current_grade": {
          "type": "string",
          "maxLength": 20
        },
        "city": {
          "type": "string",
          "maxLength": 80
        },
        "state_or_region": {
          "type": "string",
          "maxLength": 80
        },
        "country": {
          "type": "string",
          "maxLength": 80
        },
        "languages_at_home": {
          "type": "string",
          "maxLength": 160
        },
        "international": {
          "default": false,
          "description": "True if the student would need a student visa",
          "type": "boolean"
        }
      },
      "required": [
        "first_name",
        "last_name",
        "date_of_birth",
        "international"
      ],
      "additionalProperties": false
    },
    "entering_year": {
      "type": "string",
      "enum": [
        "2027 - 2028",
        "2028 - 2029"
      ],
      "description": "School year the student would enter"
    },
    "entering_grade": {
      "type": "string",
      "enum": [
        "9",
        "10",
        "11",
        "12"
      ]
    },
    "boarding_or_day": {
      "type": "string",
      "enum": [
        "boarding",
        "day",
        "undecided"
      ]
    },
    "financial_aid_interest": {
      "type": "boolean"
    },
    "how_you_found_us": {
      "type": "string",
      "maxLength": 300
    }
  },
  "additionalProperties": false,
  "$id": "https://admitprotocol.com/spec/schema/application-patch.schema.json",
  "title": "Admit Protocol application patch"
}

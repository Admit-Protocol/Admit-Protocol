{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "recommendation_math",
        "recommendation_english",
        "recommendation_counselor",
        "recommendation_personal"
      ]
    },
    "to_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "to_email": {
      "type": "string",
      "format": "email",
      "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
    },
    "note": {
      "type": "string",
      "maxLength": 300
    }
  },
  "required": [
    "type",
    "to_name",
    "to_email"
  ],
  "additionalProperties": false,
  "$id": "https://admitprotocol.com/spec/schema/recommendation-request.schema.json",
  "title": "Admit Protocol recommendation request"
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "writing",
        "parent_statement",
        "transcript",
        "report_card",
        "test_score",
        "english_competency",
        "iep_504",
        "awards",
        "additional"
      ]
    },
    "prompt": {
      "description": "For writing: the key of the school's prompt this answers (see writing_prompts in the schema)",
      "type": "string",
      "maxLength": 60
    },
    "title": {
      "type": "string",
      "maxLength": 160
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "attestation": {
      "type": "object",
      "properties": {
        "written_by": {
          "type": "string",
          "const": "student"
        },
        "agent_edited": {
          "type": "boolean",
          "const": false
        },
        "confirmed_by": {
          "type": "string",
          "enum": [
            "parent",
            "guardian"
          ],
          "description": "Who confirmed the attestation before sending"
        }
      },
      "required": [
        "written_by",
        "agent_edited",
        "confirmed_by"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "type",
    "text"
  ],
  "additionalProperties": false,
  "$id": "https://admitprotocol.com/spec/schema/text-item.schema.json",
  "title": "Admit Protocol text item",
  "description": "A text item, such as the student's writing. For type \"writing\", attestation is required and must equal {written_by: student, agent_edited: false, confirmed_by: parent|guardian}; a server must refuse otherwise. prompt names a key from the school's writing_prompts."
}
